class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class QueueLinkedList:
    def __init__(self):
        self.front = None
        self.rear = None
        self._size = 0

    def is_empty(self) -> bool:
        return self.front is None

    def enqueue(self, item):
        new_node = Node(item)
        if self.is_empty():
            self.front = new_node
            self.rear = new_node
        else:
            self.rear.next = new_node
            self.rear = new_node
        self._size += 1
        print(f"new car parked: {item}")

    def dequeue(self):
        if self.is_empty():
            print("no car parked.")
            return None
        temp = self.front
        self.front = self.front.next
        if self.front is None:
            self.rear = None
        self._size -= 1
        print(f"car is removed: {temp.data}")
        return temp.data

    def peek(self):
        if self.is_empty():
            print("no car is parked")
            return None
        return self.front.data

    def size(self) -> int:
        return self._size

    def display(self):
        if self.is_empty():
            print("no car is parked")
            return
        current = self.front
        elements = []
        while current:
            elements.append(str(current.data))
            current = current.next
        print("car(Front -> Rear): " + " -> ".join(elements))



if __name__ == "__main__":
    queue = QueueLinkedList()

    while True:
        print("\n--- car parking system ---")
        print("1. first car parked")
        print("2. car removed")
        print("3. Front car")
        print("4. no of cars")
        print("5. Display all cars")
        print("6. Exit")
        
        choice = input("Enter your choice (1-6): ").strip()

        match choice:
            case "1":
                item = input("Enter the car: ")
                queue.enqueue(item)
            case "2":
                queue.dequeue()
            case "3":
                front_item = queue.peek()
                if front_item is not None:
                    print(f"Front car is: {front_item}")
            case "4":
                print(f"Current no of cars: {queue.size()}")
            case "5":
                queue.display()
            case "6":
                print("Exiting")
                break
